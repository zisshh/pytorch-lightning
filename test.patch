+import math
+import os
+import random
+from dataclasses import dataclass
+from typing import List, Tuple
+
+import pytest
+import torch
+from torch import nn
+from torch.optim.lr_scheduler import StepLR
+from torch.utils.data import DataLoader, Dataset, IterableDataset, Sampler, TensorDataset
+
+from lightning.fabric import Fabric
+
+
+class EpochAwareSampler(Sampler[int]):
+    """Stateful sampler whose order is a function of epoch and supports state_dict.
+
+    - set_epoch(epoch) sets internal epoch used to derive order
+    - state_dict()/load_state_dict() persist and restore epoch
+    """
+
+    def __init__(self, size: int, base_seed: int = 123) -> None:
+        self.size = size
+        self.base_seed = base_seed
+        self.epoch = 0
+
+    def __len__(self) -> int:  # type: ignore[override]
+        return self.size
+
+    def __iter__(self):  # type: ignore[override]
+        g = torch.Generator().manual_seed(self.base_seed + int(self.epoch))
+        order = torch.randperm(self.size, generator=g).tolist()
+        return iter(order)
+
+    def set_epoch(self, epoch: int) -> None:
+        self.epoch = int(epoch)
+
+    # explicit state persistence API
+    def state_dict(self):  # pragma: no cover - simple container
+        return {"epoch": self.epoch}
+
+    def load_state_dict(self, state):  # pragma: no cover - simple container
+        self.epoch = int(state.get("epoch", 0))
+
+
+class CountingIterable(IterableDataset):
+    def __init__(self, n: int):
+        super().__init__()
+        self.n = n
+
+    def __iter__(self):
+        for i in range(self.n):
+            # yield float for model compatibility
+            yield torch.tensor([i], dtype=torch.float32)
+
+
+class TinyModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.lin = nn.Linear(1, 1)
+
+    def forward(self, x):
+        return self.lin(x)
+
+
+@dataclass
+class RunOut:
+    per_rank_batches: List[List[int]]
+    per_rank_losses: List[List[float]]
+    last_lr: float
+
+
+def _seed_all(seed: int) -> None:
+    random.seed(seed)
+    torch.manual_seed(seed)
+
+
+def _gather_lists(fabric: Fabric, values: List[int], losses: List[float]) -> Tuple[List[List[int]], List[List[float]]]:
+    device = fabric.device
+    Lv, Ll = len(values), len(losses)
+    m = max(Lv, Ll)
+    v = torch.tensor(values + [0] * (m - Lv), device=device)
+    l = torch.tensor(losses + [math.nan] * (m - Ll), device=device)
+    gv = fabric.all_gather(v).cpu().tolist()
+    gl = fabric.all_gather(l).cpu().tolist()
+    return gv, gl
+
+
+def _build_loader(map_dataset: bool, shuffle: bool, use_distributed_sampler: bool, N: int, batch_size: int):
+    if map_dataset:
+        ds: Dataset = TensorDataset(torch.arange(N).unsqueeze(1).float())
+        sampler = EpochAwareSampler(len(ds)) if shuffle else None
+        dl = DataLoader(ds, batch_size=batch_size, sampler=sampler, shuffle=False)
+    else:
+        ds = CountingIterable(N)
+        dl = DataLoader(ds, batch_size=batch_size)
+    return dl, use_distributed_sampler
+
+
+def _ensure_2d_float(batch: torch.Tensor | List[torch.Tensor] | Tuple[torch.Tensor, ...]) -> torch.Tensor:
+    if isinstance(batch, (list, tuple)):
+        x = batch[0]
+    else:
+        x = batch
+    x = x.to(torch.float32)
+    if x.ndim == 1:
+        x = x.unsqueeze(1)
+    return x
+
+
+def _continuous_next(
+    fabric: Fabric,
+    *,
+    map_dataset: bool,
+    shuffle: bool,
+    use_distributed_sampler: bool,
+    N: int,
+    batch_size: int,
+    warmup_steps: int,
+    check_steps: int,
+) -> RunOut:
+    _seed_all(1337 + int(fabric.global_rank))
+
+    model = TinyModel()
+    opt = torch.optim.SGD(model.parameters(), lr=0.1)
+    sch = StepLR(opt, step_size=3, gamma=0.5)
+
+    model, opt = fabric.setup(model, opt)
+    dl, uds = _build_loader(map_dataset, shuffle, use_distributed_sampler, N=N, batch_size=batch_size)
+    fdl = fabric.setup_dataloaders(dl, use_distributed_sampler=uds, move_to_device=False)
+
+    it = iter(fdl)
+
+    # warmup mid-epoch or end-epoch on the SAME iterator (uninterrupted)
+    for _ in range(warmup_steps):
+        batch = _ensure_2d_float(next(it))
+        batch = batch.to(fabric.device)
+        out = model(batch)
+        loss = torch.mean((out - 1.0) ** 2)
+        fabric.backward(loss)
+        opt.step(); opt.zero_grad(set_to_none=True); sch.step()
+
+    # collect next steps for comparison
+    vals: List[int] = []
+    losses: List[float] = []
+    for _ in range(check_steps):
+        batch = _ensure_2d_float(next(it))
+        batch = batch.to(fabric.device)
+        out = model(batch)
+        loss = torch.mean((out - 1.0) ** 2)
+        fabric.backward(loss)
+        opt.step(); opt.zero_grad(set_to_none=True); sch.step()
+        vals.extend(batch.squeeze(1).int().tolist())
+        losses.append(float(loss.detach().cpu()))
+
+    gathered_vals, gathered_loss = _gather_lists(fabric, vals, losses)
+    return RunOut(gathered_vals, gathered_loss, sch.get_last_lr()[0])
+
+
+def _resume_first(
+    fabric: Fabric,
+    *,
+    map_dataset: bool,
+    shuffle: bool,
+    use_distributed_sampler: bool,
+    N: int,
+    batch_size: int,
+    warmup_steps: int,
+    check_steps: int,
+    ckpt: str,
+) -> RunOut:
+    _seed_all(1337 + int(fabric.global_rank))
+
+    # run a first short segment and save a checkpoint, then restart fresh and run next steps
+    # first segment (fresh dataloader)
+    model = TinyModel(); opt = torch.optim.SGD(model.parameters(), lr=0.1); sch = StepLR(opt, 3, 0.5)
+    model, opt = fabric.setup(model, opt)
+    dl, uds = _build_loader(map_dataset, shuffle, use_distributed_sampler, N=N, batch_size=batch_size)
+    fdl = fabric.setup_dataloaders(dl, use_distributed_sampler=uds, move_to_device=False)
+    it = iter(fdl)
+    for _ in range(warmup_steps):
+        batch = _ensure_2d_float(next(it))
+        batch = batch.to(fabric.device)
+        out = model(batch); loss = torch.mean((out - 1.0) ** 2)
+        fabric.backward(loss); opt.step(); opt.zero_grad(set_to_none=True); sch.step()
+    # save state after warmup (mid-epoch or after completing epoch)
+    fabric.save(ckpt, {"model": model, "optimizer": opt, "scheduler": sch})
+
+    # resume segment (fresh dataloader)
+    model2 = TinyModel(); opt2 = torch.optim.SGD(model2.parameters(), lr=0.1); sch2 = StepLR(opt2, 3, 0.5)
+    fabric.load(ckpt, {"model": model2, "optimizer": opt2, "scheduler": sch2})
+    model2, opt2 = fabric.setup(model2, opt2)
+    dl2, uds2 = _build_loader(map_dataset, shuffle, use_distributed_sampler, N=N, batch_size=batch_size)
+    fdl2 = fabric.setup_dataloaders(dl2, use_distributed_sampler=uds2, move_to_device=False)
+    it2 = iter(fdl2)
+
+    vals2: List[int] = []
+    losses2: List[float] = []
+    for _ in range(check_steps):
+        batch = _ensure_2d_float(next(it2))
+        batch = batch.to(fabric.device)
+        out = model2(batch); loss = torch.mean((out - 1.0) ** 2)
+        fabric.backward(loss); opt2.step(); opt2.zero_grad(set_to_none=True); sch2.step()
+        vals2.extend(batch.squeeze(1).int().tolist()); losses2.append(float(loss.detach().cpu()))
+
+    gathered_vals2, gathered_loss2 = _gather_lists(fabric, vals2, losses2)
+    return RunOut(gathered_vals2, gathered_loss2, sch2.get_last_lr()[0])
+
+
+def _launch_compare(*, map_dataset: bool, shuffle: bool, use_distributed_sampler: bool, N: int, batch_size: int, warmup_steps: int, check_steps: int, ckpt: str) -> Tuple[RunOut, RunOut]:
+    # continuous next steps on same iterator
+    def continuous(fabric: Fabric):
+        return _continuous_next(
+            fabric,
+            map_dataset=map_dataset,
+            shuffle=shuffle,
+            use_distributed_sampler=use_distributed_sampler,
+            N=N,
+            batch_size=batch_size,
+            warmup_steps=warmup_steps,
+            check_steps=check_steps,
+        )
+
+    # resume path on fresh iterator
+    def resume_fn(fabric: Fabric):
+        return _resume_first(
+            fabric,
+            map_dataset=map_dataset,
+            shuffle=shuffle,
+            use_distributed_sampler=use_distributed_sampler,
+            N=N,
+            batch_size=batch_size,
+            warmup_steps=warmup_steps,
+            check_steps=check_steps,
+            ckpt=ckpt,
+        )
+
+    fabric = Fabric(accelerator="cpu", devices=1)
+    cont_out: RunOut = fabric.launch(continuous)
+
+    fabric2 = Fabric(accelerator="cpu", devices=1)
+    res_out: RunOut = fabric2.launch(resume_fn)
+
+    return cont_out, res_out
+
+
+@pytest.mark.parametrize("use_distributed_sampler", [True, False])
+@pytest.mark.parametrize("map_dataset", [True, False])
+@pytest.mark.parametrize("shuffle", [True, False])
+def test_resume_determinism_mid_epoch(tmp_path, map_dataset, shuffle, use_distributed_sampler):
+    """Resume mid-epoch: compare next steps from an uninterrupted iterator vs resumed fresh iterator."""
+    N, bs = 16, 2
+    warmup, check = 1, 2  # definitely mid-epoch for these sizes
+    ckpt = os.fspath(tmp_path / "ckpt_mid.pt")
+
+    continuous_next, resumed_first = _launch_compare(
+        map_dataset=map_dataset,
+        shuffle=shuffle,
+        use_distributed_sampler=use_distributed_sampler,
+        N=N,
+        batch_size=bs,
+        warmup_steps=warmup,
+        check_steps=check,
+        ckpt=ckpt,
+    )
+
+    assert resumed_first.per_rank_batches == continuous_next.per_rank_batches
+    for r_losses, c_losses in zip(resumed_first.per_rank_losses, continuous_next.per_rank_losses):
+        for r, c in zip(r_losses, c_losses):
+            if math.isnan(r) or math.isnan(c):
+                continue
+            assert math.isclose(r, c, rel_tol=1e-6, abs_tol=1e-6)
+    assert math.isclose(resumed_first.last_lr, continuous_next.last_lr, rel_tol=1e-9, abs_tol=1e-12)
+
+
+@pytest.mark.parametrize("use_distributed_sampler", [True, False])
+@pytest.mark.parametrize("map_dataset", [True, False])
+@pytest.mark.parametrize("shuffle", [True, False])
+def test_resume_determinism_across_epoch_boundary(tmp_path, map_dataset, shuffle, use_distributed_sampler):
+    """Resume exactly at epoch boundary and verify next-epoch parity."""
+    N, bs = 16, 2
+    # batches per epoch per rank = (N/2)/bs = 4; warmup exactly consumes an epoch
+    warmup, check = 4, 2
+    ckpt = os.fspath(tmp_path / "ckpt_epoch.pt")
+
+    continuous_next, resumed_first = _launch_compare(
+        map_dataset=map_dataset,
+        shuffle=shuffle,
+        use_distributed_sampler=use_distributed_sampler,
+        N=N,
+        batch_size=bs,
+        warmup_steps=warmup,
+        check_steps=check,
+        ckpt=ckpt,
+    )
+
+    assert resumed_first.per_rank_batches == continuous_next.per_rank_batches
+    for r_losses, c_losses in zip(resumed_first.per_rank_losses, continuous_next.per_rank_losses):
+        for r, c in zip(r_losses, c_losses):
+            if math.isnan(r) or math.isnan(c):
+                continue
+            assert math.isclose(r, c, rel_tol=1e-6, abs_tol=1e-6)
+    assert math.isclose(resumed_first.last_lr, continuous_next.last_lr, rel_tol=1e-9, abs_tol=1e-12)
