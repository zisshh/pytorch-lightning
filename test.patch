+import math
+import os
+from dataclasses import dataclass
+from typing import List, Tuple
+
+import pytest
+import torch
+from torch import nn
+from torch.optim.lr_scheduler import StepLR
+from torch.utils.data import DataLoader, Dataset, IterableDataset, Sampler, TensorDataset
+
+from lightning.fabric import Fabric
+
+
+class EpochAwareSampler(Sampler[int]):
+    """Stateful sampler whose order is a function of epoch."""
+
+    def __init__(self, size: int, base_seed: int = 123) -> None:
+        self.size = size
+        self.base_seed = base_seed
+        self.epoch = 0
+
+    def __len__(self) -> int:  # type: ignore[override]
+        return self.size
+
+    def __iter__(self):  # type: ignore[override]
+        g = torch.Generator().manual_seed(self.base_seed + int(self.epoch))
+        order = torch.randperm(self.size, generator=g).tolist()
+        return iter(order)
+
+    def set_epoch(self, epoch: int) -> None:
+        self.epoch = int(epoch)
+
+
+class CountingIterable(IterableDataset):
+    def __init__(self, n: int):
+        super().__init__()
+        self.n = n
+
+    def __iter__(self):
+        for i in range(self.n):
+            yield torch.tensor([i])
+
+
+class TinyModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.lin = nn.Linear(1, 1)
+
+    def forward(self, x):
+        return self.lin(x)
+
+
+@dataclass
+class RunOut:
+    per_rank_batches: List[List[int]]
+    per_rank_losses: List[List[float]]
+    last_lr: float
+
+
+def _collect_per_rank(fabric: Fabric, rank_values: List[int], rank_losses: List[float]) -> Tuple[List[List[int]], List[List[float]]]:
+    # gather lengths for safe padding (fabric.all_gather requires tensors)
+    device = fabric.device
+    max_len = max(len(rank_values), len(rank_losses))
+    pad_vals = torch.tensor(rank_values + [0] * (max_len - len(rank_values)), device=device)
+    pad_loss = torch.tensor(rank_losses + [math.nan] * (max_len - len(rank_losses)), device=device)
+
+    gathered_vals = fabric.all_gather(pad_vals).cpu().tolist()
+    gathered_loss = fabric.all_gather(pad_loss).cpu().tolist()
+
+    # trim padding by original lengths (assume equal lengths across ranks in these tests)
+    return gathered_vals, gathered_loss
+
+
+def _build_loader(map_dataset: bool, shuffle: bool, use_distributed_sampler: bool, N: int = 8, batch_size: int = 2):
+    if map_dataset:
+        ds: Dataset = TensorDataset(torch.arange(N).unsqueeze(1).float())
+        sampler = EpochAwareSampler(len(ds)) if shuffle else None
+        dl = DataLoader(ds, batch_size=batch_size, sampler=sampler, shuffle=False)
+    else:
+        ds = CountingIterable(N)
+        dl = DataLoader(ds, batch_size=batch_size)
+    return dl, use_distributed_sampler
+
+
+def _segment(fabric: Fabric, *, map_dataset: bool, shuffle: bool, use_distributed_sampler: bool, steps: int, ckpt: str = "", resume: bool = False) -> RunOut:
+    model = TinyModel()
+    opt = torch.optim.SGD(model.parameters(), lr=0.1)
+    sch = StepLR(opt, step_size=3, gamma=0.5)
+
+    if resume:
+        fabric.load(ckpt, {"model": model, "optimizer": opt, "scheduler": sch})
+
+    model, opt = fabric.setup(model, opt)
+    dl, uds = _build_loader(map_dataset, shuffle, use_distributed_sampler)
+    fdl = fabric.setup_dataloaders(dl, use_distributed_sampler=uds, move_to_device=False)
+
+    per_rank_batches: List[int] = []
+    per_rank_losses: List[float] = []
+
+    it = iter(fdl)
+    for _ in range(steps):
+        batch = next(it)[0].to(fabric.device)
+        out = model(batch)
+        loss = torch.mean((out - 1.0) ** 2)
+        fabric.backward(loss)
+        opt.step()
+        opt.zero_grad(set_to_none=True)
+        sch.step()
+
+        per_rank_batches.extend(batch.squeeze(1).int().tolist())
+        per_rank_losses.append(float(loss.detach().cpu()))
+
+    # save only when not resuming
+    if not resume and ckpt:
+        fabric.save(ckpt, {"model": model, "optimizer": opt, "scheduler": sch})
+
+    gathered_vals, gathered_loss = _collect_per_rank(fabric, per_rank_batches, per_rank_losses)
+
+    return RunOut(gathered_vals, gathered_loss, sch.get_last_lr()[0])
+
+
+def _launch_and_run(map_dataset: bool, shuffle: bool, use_distributed_sampler: bool, steps_warmup: int, steps_check: int, ckpt: str) -> Tuple[RunOut, RunOut]:
+    # continuous run: warmup + check in one launch
+    def continuous(fabric: Fabric):
+        c1 = _segment(fabric, map_dataset=map_dataset, shuffle=shuffle, use_distributed_sampler=use_distributed_sampler, steps=steps_warmup, ckpt=ckpt, resume=False)
+        c2 = _segment(fabric, map_dataset=map_dataset, shuffle=shuffle, use_distributed_sampler=use_distributed_sampler, steps=steps_check, ckpt="", resume=False)
+        return c1, c2
+
+    # resume run: warmup then restart from ckpt and run check steps
+    def resume_run(fabric: Fabric):
+        _ = _segment(fabric, map_dataset=map_dataset, shuffle=shuffle, use_distributed_sampler=use_distributed_sampler, steps=steps_warmup, ckpt=ckpt, resume=False)
+        r = _segment(fabric, map_dataset=map_dataset, shuffle=shuffle, use_distributed_sampler=use_distributed_sampler, steps=steps_check, ckpt=ckpt, resume=True)
+        return r
+
+    # launch 2-device cpu ddp
+    fabric = Fabric(accelerator="cpu", strategy="ddp", devices=2)
+    cont_out: Tuple[RunOut, RunOut] = fabric.launch(continuous)
+
+    fabric2 = Fabric(accelerator="cpu", strategy="ddp", devices=2)
+    res_out: RunOut = fabric2.launch(resume_run)
+
+    # unpack
+    continuous_next = cont_out[1]
+    resumed_first = res_out
+    return continuous_next, resumed_first
+
+
+@pytest.mark.parametrize("map_dataset", [True, False])
+@pytest.mark.parametrize("shuffle", [True, False])
+@pytest.mark.parametrize("use_distributed_sampler", [True, False])
+def test_resume_determinism_parity(tmp_path, map_dataset, shuffle, use_distributed_sampler):
+    """Parity test across ranks: batch indices and losses after resume must match continuous run.
+
+    This exercises:
+    - Map vs Iterable datasets
+    - shuffle on/off
+    - use_distributed_sampler True/False
+    - LR scheduler, model, optimizer restoration
+    """
+
+    ckpt = os.fspath(tmp_path / "ckpt.pt")
+    steps_warmup, steps_check = 2, 2
+
+    continuous_next, resumed_first = _launch_and_run(
+        map_dataset=map_dataset,
+        shuffle=shuffle,
+        use_distributed_sampler=use_distributed_sampler,
+        steps_warmup=steps_warmup,
+        steps_check=steps_check,
+        ckpt=ckpt,
+    )
+
+    # Per-rank batch parity
+    assert (
+        resumed_first.per_rank_batches == continuous_next.per_rank_batches
+    ), "Per-rank batch index parity must hold after resume"
+
+    # Per-rank loss parity (allow tiny tolerance)
+    for r_losses, c_losses in zip(resumed_first.per_rank_losses, continuous_next.per_rank_losses):
+        assert len(r_losses) == len(c_losses)
+        for r, c in zip(r_losses, c_losses):
+            assert math.isclose(r, c, rel_tol=1e-6, abs_tol=1e-6)
+
+    # LR scheduler parity
+    assert math.isclose(resumed_first.last_lr, continuous_next.last_lr, rel_tol=1e-9, abs_tol=1e-12)
+
+
+# Focus runner for the checker (short runtime) covering shuffle=True on map dataset
+@pytest.mark.parametrize("use_distributed_sampler", [True, False])
+def test_resume_determinism_smoke_resume_on_map_shuffle(tmp_path, use_distributed_sampler):
+    ckpt = os.fspath(tmp_path / "ckpt.pt")
+    steps_warmup, steps_check = 1, 2
+    continuous_next, resumed_first = _launch_and_run(
+        map_dataset=True,
+        shuffle=True,
+        use_distributed_sampler=use_distributed_sampler,
+        steps_warmup=steps_warmup,
+        steps_check=steps_check,
+        ckpt=ckpt,
+    )
+    assert resumed_first.per_rank_batches == continuous_next.per_rank_batches
